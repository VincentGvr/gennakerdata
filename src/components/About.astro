---
import { Image } from 'astro:assets';
import portrait from '../assets/blog/2022/08/img-20190917-wa0000__011-copy1-2.jpg';
import { AUTHOR, LINKEDIN_URL } from '../consts';

interface Props {
	headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section class="about" id="a-propos" aria-labelledby="about-title">
	<Image
		class="portrait"
		src={portrait}
		alt={`Portrait de ${AUTHOR}`}
		width={240}
		height={240}
		loading="lazy"
	/>
	<div>
		<Heading id="about-title">À propos</Heading>
		<p>
			Je suis <strong>Vincent Guyonvarch</strong>, <strong>Cloud Solution Architect Data &amp; AI</strong>
			chez Microsoft. J’accompagne les clients sur Azure et Microsoft Fabric, et j’enseigne les
			<strong>bases de données avancées</strong> à l’Université Paris 1 Panthéon-Sorbonne.
		</p>
		<p>
			Ce blog rassemble mes retours d’expérience et mes scripts sur Azure, Microsoft Fabric, Power
			BI, PowerShell et SQL.
		</p>
		<p>
			<a class="button" href={LINKEDIN_URL} rel="me noopener" target="_blank">
				Me contacter sur LinkedIn
			</a>
		</p>
	</div>
</section>
