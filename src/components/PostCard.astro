---
import { Image } from 'astro:assets';
import { formatDate, postHref, readingTime, type Post } from '../utils';

interface Props {
	post: Post;
	eager?: boolean;
}
const { post, eager = false } = Astro.props;
const { data } = post;
---

<article class="card">
	{
		data.heroImage && (
			<a class="card-media" href={postHref(post)} tabindex="-1" aria-hidden="true">
				<Image
					src={data.heroImage}
					alt=""
					width={640}
					height={360}
					loading={eager ? 'eager' : 'lazy'}
					decoding="async"
				/>
			</a>
		)
	}
	<div class="card-body">
		<h3 class="card-title">
			<a href={postHref(post)}>{data.title}</a>
		</h3>
		<p class="meta">
			<time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, data.lang)}</time>
			{' · '}{readingTime(post.body)} min{' '}
			{data.lang === 'en' && <span class="badge">EN</span>}
		</p>
		<p class="card-desc">{data.description}</p>
	</div>
</article>
