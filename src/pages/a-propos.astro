---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import About from '../components/About.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="À propos"
	description="Vincent Guyonvarch, Cloud Solution Architect Data & AI chez Microsoft, enseignant en bases de données avancées à l’Université Paris 1."
>
	<div class="wrapper page">
		<About headingLevel="h1" />
		<figure class="about-logo">
			<Image
				class="logo-art"
				src={logo}
				alt="Logo Gennaker Data : schéma éclaté d’un disque dur"
				width={420}
				loading="lazy"
			/>
		</figure>
	</div>
</BaseLayout>
