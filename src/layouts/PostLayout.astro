---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import { AUTHOR, SITE_TITLE } from '../consts';
import { categoryHref, formatDate, postHref, readingTime, withBase, type Post } from '../utils';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	translation?: Post;
}
const { post, headings, translation } = Astro.props;
const { data } = post;

const minDepth = Math.min(...headings.map((h) => h.depth), 6);
const toc = headings.filter((h) => h.depth <= minDepth + 1);
const minutes = readingTime(post.body);
const canonical = data.canonicalPermalink ?? data.permalink;
const canonicalUrl = new URL(withBase(canonical), Astro.site).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: data.title,
	description: data.description,
	inLanguage: data.lang,
	datePublished: data.pubDate.toISOString(),
	dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
	author: { '@type': 'Person', name: AUTHOR },
	publisher: { '@type': 'Organization', name: SITE_TITLE },
	mainEntityOfPage: canonicalUrl,
	keywords: data.tags.join(', '),
};
---

<BaseLayout
	title={data.title}
	description={data.description}
	image={data.heroImage}
	type="article"
	lang={data.lang}
	canonical={withBase(canonical)}
	pubDate={data.pubDate}
	updatedDate={data.updatedDate}
	tags={data.tags}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />
	<div class="wrapper post-layout">
		<article class="post" data-pagefind-body>
			<header class="post-header">
				{
					data.categories.length > 0 && (
						<ul class="chips" aria-label="Catégories">
							{data.categories.map((c) => (
								<li>
									<a href={categoryHref(c)}>{c}</a>
								</li>
							))}
						</ul>
					)
				}
				<h1 data-pagefind-meta="title">{data.title}</h1>
				<p class="meta">
					<time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, data.lang)}</time>
					{
						data.updatedDate && (
							<span>
								{' · '}mis à jour le{' '}
								<time datetime={data.updatedDate.toISOString()}>
									{formatDate(data.updatedDate, data.lang)}
								</time>
							</span>
						)
					}
					{' · '}<span>{minutes} min de lecture</span>
				</p>
				{
					translation && (
						<p class="notice" lang={translation.data.lang}>
							{translation.data.lang === 'en' ? 'This article is also available in English: ' : 'Cet article est aussi disponible en français : '}
							<a href={postHref(translation)} hreflang={translation.data.lang}>
								{translation.data.title}
							</a>
						</p>
					)
				}
				{
					data.canonicalPermalink && (
						<p class="notice">
							Cet article existe aussi à une autre adresse :{' '}
							<a href={withBase(data.canonicalPermalink)}>version de référence</a>.
						</p>
					)
				}
				{
					data.missingImages > 0 && (
						<p class="notice warning" role="note">
							{data.missingImages} illustration{data.missingImages > 1 ? 's' : ''} de cet article ne
							sont plus disponibles (images hébergées sur LinkedIn, expirées avant la migration).
						</p>
					)
				}
			</header>

			{
				data.heroImage && !data.hideHero && (
					<Image
						class="post-hero"
						src={data.heroImage}
						alt=""
						width={1200}
						loading="eager"
						data-pagefind-ignore
					/>
				)
			}

			<div class="prose">
				<slot />
			</div>
		</article>

		{
			toc.length > 1 && (
				<aside class="toc" aria-label="Sommaire">
					<details open>
						<summary>Sommaire</summary>
						<ol>
							{toc.map((h) => (
								<li class={h.depth === minDepth ? 'toc-l1' : 'toc-l2'}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ol>
					</details>
				</aside>
			)
		}
	</div>
</BaseLayout>
